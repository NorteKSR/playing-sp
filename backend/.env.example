# ---------------------------------------------------------------------------
# Twitch "Now Playing on Spotify" EBS configuration. Copy to .env and fill in.
# NEVER commit .env. Generate local test values with: npm run gen-secrets
# ---------------------------------------------------------------------------

# --- Server ---
PORT=8080
HOST=0.0.0.0
# Public HTTPS base URL of this EBS (informational; e.g. your tunnel or deployment URL, https://<your-app>.fly.dev)
PUBLIC_BASE_URL=https://<your-app>.fly.dev
# Where the file token store lives (tokens.json, encrypted). Must be persistent in production.
DATA_DIR=./data
LOG_LEVEL=info
# Comma-separated allowed CORS origins. Default: https://<TWITCH_EXTENSION_CLIENT_ID>.ext-twitch.tv
# Add your local frontend dev server for local testing, e.g. http://localhost:8081
CORS_ALLOWED_ORIGINS=https://YOUR_TWITCH_EXTENSION_CLIENT_ID.ext-twitch.tv,http://localhost:8081
# Twitch "Local Test" serves the frontend from the console's Testing Base URI origin. These origins are ADDED to
# CORS_ALLOWED_ORIGINS. Default (unset): https://localhost:8080. Comma-separated; set to empty to disable (production).
# Note: if the frontend Local Test server uses port 8080 on the same machine, run this EBS on another PORT.
TWITCH_LOCAL_TEST_ORIGINS=https://localhost:8080
# Optional channel allowlist: comma-separated numeric Twitch channel IDs allowed to use this EBS
# (link, status, unlink, now-playing, polling). Others get 403 channel_not_allowed ("This extension is private.").
# Unset/empty = all channels allowed. A non-numeric entry fails startup. Example: ALLOWED_CHANNEL_IDS=12345678,87654321
# ALLOWED_CHANNEL_IDS=
# Per user+channel request limit on /api/* (fixed 1-minute window)
API_RATE_LIMIT_PER_MINUTE=120

# --- Spotify (developer.spotify.com/dashboard) ---
SPOTIFY_CLIENT_ID=YOUR_SPOTIFY_CLIENT_ID
SPOTIFY_CLIENT_SECRET=YOUR_SPOTIFY_CLIENT_SECRET
# Must EXACTLY match a Redirect URI registered in the Spotify app.
# HTTPS required; only loopback IP literals may use http (http://127.0.0.1:8080/...). "localhost" is rejected by Spotify.
SPOTIFY_REDIRECT_URI=https://<your-app>.fly.dev/auth/spotify/callback
# Add PKCE (S256) on top of the server-side client secret (recommended)
SPOTIFY_USE_PKCE=true
# Override only for testing against mocks
# SPOTIFY_ACCOUNTS_BASE=https://accounts.spotify.com
# SPOTIFY_API_BASE=https://api.spotify.com/v1

# --- Twitch extension (dev.twitch.tv/console/extensions) ---
TWITCH_EXTENSION_CLIENT_ID=YOUR_TWITCH_EXTENSION_CLIENT_ID
# Extension secret EXACTLY as shown in the console (base64). It is base64-decoded before HS256 signing/verifying.
TWITCH_EXTENSION_SECRET=YOUR_TWITCH_EXTENSION_SECRET_BASE64
# Twitch user ID of the extension owner (used as user_id in EBS-signed PubSub JWTs)
TWITCH_EXTENSION_OWNER_ID=YOUR_TWITCH_USER_ID
# true = log PubSub messages instead of sending (local dev without a real extension)
TWITCH_PUBSUB_DISABLED=false
TWITCH_JWT_CLOCK_TOLERANCE_SEC=5
# Optional: Twitch "Required Configurations". When BOTH are set, the EBS calls Helix
# PUT /extensions/required_configuration after a successful Spotify link so the broadcaster can activate the
# extension. Must match Console -> Capabilities -> "Custom/My Own Service" -> Required Configurations string,
# and the extension version the broadcaster has installed (e.g. 0.0.1).
TWITCH_EXTENSION_VERSION=
TWITCH_REQUIRED_CONFIGURATION=
# Optional value written on unlink (e.g. "unlinked"). Empty = leave Twitch's value alone (recommended; see README).
TWITCH_REQUIRED_CONFIGURATION_ON_UNLINK=
# TWITCH_API_BASE=https://api.twitch.tv/helix

# --- Token encryption at rest ---
# 32 random bytes, base64 (44 chars) or hex (64 chars): openssl rand -base64 32
# Also used (via HKDF) to sign the OAuth state parameter. Rotating it invalidates stored tokens (users must relink).
TOKEN_ENCRYPTION_KEY=YOUR_32_BYTE_BASE64_KEY

# --- Poller ---
POLLER_ENABLED=true
POLL_INTERVAL_PLAYING_MS=5000
POLL_INTERVAL_PAUSED_MS=15000
POLL_INTERVAL_IDLE_MS=30000
POLL_MAX_BACKOFF_MS=300000
# Back-off when Spotify returns 429 {"reason":"QUOTA_EXCEEDED"} without Retry-After (dev-mode quota)
POLL_QUOTA_BACKOFF_MS=600000
HEARTBEAT_INTERVAL_MS=60000
SEEK_THRESHOLD_MS=10000
# Only poll channels whose extension was loaded recently (saves Spotify quota). The frontend
# re-fetches GET /api/now-playing every ~5 min as a keep-alive (see API_CONTRACT.md).
POLL_ONLY_WHEN_VIEWED=true
VIEWER_ACTIVITY_WINDOW_MS=600000
