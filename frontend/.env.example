# Frontend build/test environment variables (reference only).
# The frontend scripts do NOT load a .env file: export these in your shell or prefix the command, e.g.
#   EBS_BASE_URL=https://<your-app>.fly.dev npm run package

# Public HTTPS URL of your EBS (backend). Required for `npm run package`; must be https://.
# The same origin must be in the Twitch console "Allowlist for URL Fetching Domains".
EBS_BASE_URL=https://<your-app>.fly.dev

# --- Dev harness only (npm run dev) ---
# Point the harness at a real local EBS instead of the built-in mock EBS:
# EBS_BASE_URL=http://localhost:8080
# Base64 extension secret used to sign dev JWTs. Must match the EBS TWITCH_EXTENSION_SECRET when using a real EBS.
# DEV_EXTENSION_SECRET=YOUR_TWITCH_EXTENSION_SECRET_BASE64
# DEV_CLIENT_ID=YOUR_TWITCH_EXTENSION_CLIENT_ID
# PORT=8081
# MOCK_EBS_PORT=8090

# --- Tests ---
# Path to a Chrome/Chromium binary for test:e2e and test:integration (auto-detected if unset)
# CHROME_PATH=/usr/bin/chromium
